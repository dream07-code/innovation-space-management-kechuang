# Copy to deploy/.env and replace every placeholder. Never commit deploy/.env.
DB_NAME=innovation_space
DB_USERNAME=innovation_app
DB_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-database-root-password
MEMBER_INITIAL_PASSWORD=replace-with-private-initial-password

# First-run admin bootstrap. Keep these values in the ignored deploy/.env only.
INIT_ADMIN=true
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=replace-with-private-admin-password
ADMIN_DISPLAY_NAME=学院管理员

HTTP_PORT=80
BACKEND_IMAGE=innovation-space-backend:local
FRONTEND_IMAGE=innovation-space-frontend:local

# Must be explicitly confirmed before enabling report submissions.
REPORT_POINTS_POLICY_STATUS=PENDING_CONFIRMATION
REPORT_POINTS_MODE=FINAL_SCORE
REPORT_MAX_FINAL_SCORE=3

# disabled|mock|heuristic|openai-compatible。heuristic 为离线近似评分，生产建议使用 openai-compatible。
AI_SCORING_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

OJ_PROVIDER=mock
OJ_BASE_URL=
OJ_API_TOKEN=
# Ubuntu 24.04 / cgroup v2 主机必须为 true，否则 Judge0 1.13.1 会因 isolate 无法创建
# 控制组返回状态 13（页面上表现为“内部错误”）。该模式降低资源隔离强度，启用前需完成验收。
OJ_RLIMIT_FALLBACK=true
# 单次判题请求超时（毫秒）；低配/高负载主机建议 60000-120000
OJ_REQUEST_TIMEOUT_MS=60000
