# Judge0 runtime configuration example. Copy to judge0.conf and replace the change-me values.
JUDGE0_TELEMETRY_ENABLE=false
RESTART_MAX_TRIES=10
ENABLE_WAIT_RESULT=true
ENABLE_COMPILER_OPTIONS=false
ENABLE_COMMAND_LINE_ARGUMENTS=false
ENABLE_BATCHED_SUBMISSIONS=false
ENABLE_CALLBACKS=false
ENABLE_ADDITIONAL_FILES=false
ENABLE_SUBMISSION_DELETE=false
ALLOW_ENABLE_NETWORK=false
ENABLE_NETWORK=false
# 编译阶段使用该值作为 isolate 的内存上限（rlimit 模式下是 RLIMIT_AS）。
# cgroup v2 主机上 JVM/Node 需要 1GB 以上虚拟地址空间，默认 512000 会让 Java 编译失败。
# 应用侧的 OJ_RUNTIME_MEMORY_LIMIT_KB 必须不大于该值。
MAX_MEMORY_LIMIT=1600000
INTERVAL=0.1
COUNT=1
MAX_QUEUE_SIZE=50
AUTHN_TOKEN=change-me-to-a-long-random-token
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=change-me-db-password
RAILS_ENV=production
RAILS_MAX_THREADS=8
RAILS_SERVER_PROCESSES=1
SECRET_KEY_BASE=change-me-to-a-long-random-secret
