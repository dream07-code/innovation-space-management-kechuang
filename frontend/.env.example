# 复制为 .env.local 后按需修改。不要提交 .env.local 或任何含真实凭据的文件。
# 根 .gitignore 已忽略 .env / .env.*，并保留 .env.example 入库。

# 业务接口基础地址。
# 留空（推荐）= 同源相对路径，开发环境交由 Vite dev proxy 转发到后端，
# 生产环境由反向代理同源提供。契约 servers 为 "/"，业务路径自带 /api/v1 前缀。
VITE_API_BASE_URL=

# 开发环境 dev proxy 的目标后端。后端默认监听 127.0.0.1:8080。
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# 是否启用 MSW 拦截并用虚构数据模拟后端。
# 默认关闭：即使是开发环境也调用真实后端，避免把模拟数据当成产品能力。
# 仅在脱离后端做纯前端调试时临时改成 true。
VITE_USE_MOCK=false
