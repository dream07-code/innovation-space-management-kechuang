          "expectedOutput": "false"
        },
        {
          "input": "[\"([)]\"]",
          "expectedOutput": "false"
        },
        {
          "input": "[\"{[]}\"]",
          "expectedOutput": "true"
        },
        {
          "input": "[\"\"]",
          "expectedOutput": "true"
